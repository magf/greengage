#!/usr/bin/make -f
# Run command: `make -C ./gpdb_src/gpAux pkg-deb`

DH_VERBOSE = 1
export DH_OPTIONS = -v
export DEB_BUILD_OPTIONS = nocheck
export PATH := /usr/local/bin:$(PATH)

%:
	dh $@ --with python3

override_dh_auto_clean:
	@echo "Skipping clean"

override_dh_auto_configure:
	@echo "Skipping configure"

override_dh_auto_build:
	@echo "Skipping autobuild"

override_dh_auto_install:
	@echo "=== Building and installing with GPROOT=$(GPROOT), GPDIR=$(GPDIR), PACKAGE_NAME=$(PACKAGE_NAME) ==="
	env -u CFLAGS -u CPPFLAGS -u CXXFLAGS -u LDFLAGS \
	$(MAKE) dist \
		DESTDIR=$(CURDIR)/debian/tmp/$(PACKAGE_NAME) \
		GPROOT=$(GPROOT) \
		GPDIR=$(GPDIR) \
		PARALLEL_MAKE_OPTS=-j$(shell nproc)

override_dh_python3:
	@pip install pipreqs 2>/dev/null
	@$(eval IGNORE_DIRS := $(shell \
		grep 'path = ' ../.gitmodules 2>/dev/null \
		| awk '{print $$3}' \
		| tr '\n' ','))
	@pipreqs --print --ignore "$(IGNORE_DIRS)" .. 2>/tmp/pipreqs.log \
		| grep '==' \
		| cut -d= -f1 \
		| sort -u > /tmp/requirements.txt
	@test -s /tmp/requirements.txt || (echo "ERROR: pipreqs returned empty requirements" && cat /tmp/pipreqs.log && exit 1)
	cat /tmp/requirements.txt
	dh_python3 \
	 --no-ext-rename \
	 --no-shebang-rewrite \
	 --requires=/tmp/requirements.txt ..

override_dh_perl:
	dh_perl ..

override_dh_dwz:
	@echo "Skipping dwz"

override_dh_fixperms:
	dh_fixperms
	# Remove executable bit from Python/Perl/Bash modules without shebang
	find $(CURDIR)/debian/$(PACKAGE_NAME) -type f \( -name "*.py" -o -name "*.pm" -o -name "*.sh" \) -executable | while read f; do \
	    if ! head -1 "$$f" | grep -q '^#!'; then \
	        chmod -x "$$f"; \
	    fi; \
	done

override_dh_gencontrol:
	@echo "=== GENCONTROL GPROOT=$(GPROOT), GPDIR=$(GPDIR), PACKAGE_NAME=$(PACKAGE_NAME) ==="
	@echo "=== SUBVARS debian/$(PACKAGE_NAME).substvars"
	@cat debian/$(PACKAGE_NAME).substvars
	dh_gencontrol
